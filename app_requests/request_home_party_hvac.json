{
  "schema_version": "smartpriv_application_request_v1",
  "description": "Application utility contract for a privacy-aware preprocessing hub. Candidate pipeline metadata is checked against this request for output compatibility, utility capability, CI constraints, and residual disclosure bounds.",
  "vocabulary_dependencies": {
    "ci_vocabulary": "ci_pipeline_vocab_v2",
    "operator_contracts": "smartpriv_operator_contracts_v1",
    "pipeline_vocabulary": "application_pipeline_vocabulary.json"
  },
  "request_identity": {
    "request_id": "req_home_party_hvac_occupancy",
    "scenario_id": "home_party_hvac",
    "application_name": "Occupancy-aware HVAC/Lighting Controller",
    "application_category": "energy_management",
    "natural_language_request": "Estimate room occupancy during an at-home party so HVAC and lighting can adjust automatically.",
    "requester": "downstream_application"
  },
  "ci_context": {
    "context": [
      "home"
    ],
    "space": [
      "living_room",
      "common_area",
      "interior_home_space"
    ],
    "sender": [
      "owner_controlled_device"
    ],
    "subject": [
      "resident",
      "guest",
      "bystander"
    ],
    "recipient": [
      "downstream_application"
    ],
    "purpose": [
      "energy_management"
    ],
    "transmissionPrinciple_assumed": [
      "local_processing",
      "data_minimized",
      "aggregate_only",
      "no_raw_data_retention"
    ],
    "social_context_tags": [
      "guests_present",
      "routine_use",
      "weak_preference_channel",
      "operator_subject_separation"
    ]
  },
  "source_requirements": {
    "allowed_sensing_devices": [
      "indoor_camera",
      "motion_sensor",
      "thermostat"
    ],
    "allowed_content_types": [
      "image_content",
      "video_content",
      "input_data"
    ],
    "allowed_modalities": [
      "visual",
      "motion",
      "environmental"
    ],
    "forbidden_sensing_devices": [
      "microphone",
      "smart_speaker"
    ],
    "forbidden_content_types": [
      "audio_content"
    ],
    "notes": "Camera may be used only if output is minimized to occupancy; motion/environmental sensors are preferred when available."
  },
  "utility_contract": {
    "requested_capability": "occupancy_estimation",
    "task_description": "Provide room-level occupied/unoccupied state or approximate count for automation.",
    "quality_requirements": {
      "latency_ms_max": 300000,
      "update_period_ms_max": 300000,
      "minimum_recall": null,
      "minimum_precision": null,
      "minimum_accuracy": 0.9,
      "count_mae_max": 2,
      "confidence_min": null
    },
    "accepted_output_caps": [
      {
        "cap_id": "binary_occupancy",
        "semantic_type": "application/x-binary-occupancy",
        "schema": "room_occupied",
        "affordance": "WoT.property",
        "required_informationType": {
          "sensorPrimitive": [],
          "interpretedObservation": [
            "room_occupied"
          ],
          "inferredInformationType": []
        },
        "required_transmissionPrinciple": [
          "aggregate_only",
          "data_minimized"
        ],
        "priority": 1,
        "utility_notes": "Sufficient for simple HVAC/lighting automation."
      },
      {
        "cap_id": "occupancy_count",
        "semantic_type": "application/x-occupancy-count",
        "schema": "occupancy_count",
        "affordance": "WoT.property",
        "required_informationType": {
          "sensorPrimitive": [],
          "interpretedObservation": [
            "occupancy_count"
          ],
          "inferredInformationType": []
        },
        "required_transmissionPrinciple": [
          "aggregate_only",
          "data_minimized"
        ],
        "priority": 2,
        "utility_notes": "Useful when count-based HVAC control is required."
      }
    ],
    "explicitly_rejected_output_caps": [
      {
        "semantic_type": "video/x-raw",
        "reason": "Raw or near-raw video is unnecessary for energy management."
      },
      {
        "semantic_type": "audio/x-raw",
        "reason": "Audio is unnecessary for HVAC and can reveal speech."
      },
      {
        "semantic_type": "application/x-pose-keypoints",
        "reason": "Pose is more detailed than needed for HVAC."
      }
    ]
  },
  "compatibility_constraints": {
    "output_pipeline_stage_must_be": "output_to_application",
    "accepted_schema_match": "candidate output caps must match at least one accepted_output_caps entry",
    "required_capability_match": "candidate utility_capabilities must include requested_capability or a declared equivalent",
    "adapter_allowed": true,
    "adapter_rules": [
      "An adapter is allowed only if it preserves the accepted schema and does not add forbidden residual attributes."
    ]
  },
  "ci_output_constraints": {
    "required_ci_terms": {
      "informationType.sensorPrimitive": [],
      "informationType.interpretedObservation": [
        "room_occupied OR occupancy_count"
      ],
      "informationType.inferredInformationType": [],
      "transmissionPrinciple": [
        "aggregate_only",
        "data_minimized",
        "local_processing"
      ]
    },
    "forbidden_ci_terms": {
      "informationType.sensorPrimitive": [
        "video_stream",
        "audio_waveform",
        "speech_audio"
      ],
      "informationType.interpretedObservation": [
        "speech_transcribed",
        "pose_keypoints"
      ],
      "informationType.inferredInformationType": [
        "identity",
        "trajectory"
      ],
      "transmissionPrinciple": [
        "cloud_processing",
        "indefinite_retention"
      ]
    },
    "required_transformations_if_media_output": [
      "identity_removed",
      "field_of_view_minimized"
    ],
    "preferred_ci_terms": {
      "informationType.interpretedObservation": [
        "room_occupied",
        "occupancy_count"
      ],
      "informationType.inferredInformationType": [],
      "transmissionPrinciple": [
        "aggregate_only",
        "data_minimized",
        "no_raw_data_retention"
      ]
    }
  },
  "residual_disclosure_constraints": {
    "risk_order": {
      "none": 0,
      "low": 1,
      "medium": 2,
      "high": 3,
      "unknown": 4
    },
    "max_allowed": {
      "identity": "none",
      "face": "none",
      "body_shape": "none",
      "clothing": "none",
      "gait": "none",
      "speech_content": "none",
      "speaker_identity": "none",
      "activity": "low",
      "location": "medium",
      "trajectory": "low",
      "co_presence": "medium",
      "visible_text": "none",
      "aggregate_presence": "high"
    },
    "hard_forbidden_attributes": [
      "identity",
      "face",
      "speech_content",
      "speaker_identity",
      "visible_text",
      "gait",
      "clothing",
      "body_shape"
    ],
    "allowed_high_attributes": [
      "aggregate_presence"
    ],
    "comparison_rule": "candidate residual disclosure vector must be <= max_allowed for every attribute, except attributes listed in allowed_high_attributes"
  },
  "no_compromise_conditions": [
    "Return no_compromise if no candidate pipeline both matches an accepted output cap and satisfies CI/residual-disclosure constraints.",
    "Return insufficient_utility_evidence if output schema is accepted but no benchmark, calibration, or app-provided validation exists.",
    "Return consent_or_review_required if the only utility-preserving candidates expose hard-forbidden attributes."
  ],
  "verification_spec": {
    "inputs": {
      "candidate_pipeline_metadata": "typed operator-effect output from pipeline analyzer",
      "candidate_residual_disclosure": "D_meta or Combine(D_meta, D_probe)",
      "candidate_ci_flow": "f_p = <sender, subject, recipient, attribute, purpose, transmission, context>"
    },
    "checks": [
      "pipelineStage == output_to_application",
      "output caps match accepted_output_caps",
      "utility capability and quality requirements are met or marked for validation",
      "required CI terms are present",
      "forbidden CI terms are absent",
      "residual disclosure vector satisfies max_allowed",
      "candidate is ranked by least residual disclosure among feasible outputs"
    ],
    "expected_result_format": {
      "decision": "<select_pipeline | no_compromise | consent_or_review_required | insufficient_utility_evidence>",
      "selected_output_cap": "<cap_id>",
      "selected_pipeline_id": "<optional>",
      "failed_checks": [],
      "explanation": "<short reason>"
    }
  }
}