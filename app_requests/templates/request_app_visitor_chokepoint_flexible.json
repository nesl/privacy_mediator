  "no_compromise_conditions": [
    "Return no_compromise if no candidate pipeline matches any accepted output cap and satisfies context-specific CI/residual-disclosure constraints.",
    "Return insufficient_utility_evidence if an output cap/schema is accepted by this contract but no benchmark, calibration, adapter, or app-provided validation exists for that representation.",
