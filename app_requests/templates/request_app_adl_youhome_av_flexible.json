    "application_name": "YouHome Audio-Visual ADL Inference App",
    "application_category": "adl_recognition",
    "natural_language_request": "Provide the least-revealing representation sufficient for ADL recognition: AV samples, redacted/filtered AV, pose, detections, sound-event primitives, activity labels, or aggregates.",
