    "scenario_id": "app_fall_le2i_flexible",
    "application_name": "LE2I Pose Fall Inference App",
    "application_category": "fall_detection",
    "natural_language_request": "Provide a least-revealing visual or motion representation sufficient for fall detection: redacted video, pose, activity primitives, or a guarded safety event.",
    "requester": "downstream_application",
    "request_family": "flexible_multi_output_app_request",
    "not_a_context_study_case": true,
    "interface_model": "multi_representation_utility_contract",
    "flexible_tag": true
  },
  "ci_context": {
    "context": [],
    "space": [],
    "sender": [],
