{
  "schema_version": "ci_pipeline_vocab_v2",
  "design_notes": [
    "This vocabulary is specialized for a privacy preprocessor that sits before a downstream application.",
    "It removes deny_scope/operationScope and instead uses pipelineStage to describe where a rule applies.",
    "Sensors/devices are modeled in sensingDataMetadata, while data/meaning are modeled in informationType.",
    "Rules should match candidate staged flows and produce effects such as DENY_FLOW, REQUIRE_CONDITION, CLASSIFY_AS, or REQUIRE_TRANSFORMATION."
  ],
  "sources": {
    "ci": "Contextual Integrity theory / created CI schema terms",
    "dpv": "Data Privacy Vocabulary",
    "dpv-pd": "DPV Personal Data Categories extension",
    "dpv-tech": "DPV Technology Concepts extension",
    "sosa": "Sensor, Observation, Sample, and Actuator ontology",
    "ssn": "Semantic Sensor Network ontology",
    "smartpriv": "Created smart-space privacy vocabulary extension",
    "policy": "Concrete policy source"
  },
  "coreCandidateFlowFields": {
    "pipelineStage": {
      "description": "Where the flow occurs relative to the privacy preprocessor.",
      "terms": [
        {
          "term": "raw_input",
          "source": "created",
          "meaning": "Raw sensor stream/data consumed by the preprocessor."
        },
        {
          "term": "intermediate_representation",
          "source": "created",
          "meaning": "Internal transformed representation, such as pose, detections, transcript, or blurred frame."
        },
        {
          "term": "output_to_application",
          "source": "created",
          "meaning": "Data emitted from the preprocessor to the downstream app."
        },
        {
          "term": "retained_artifact",
          "source": "created",
          "meaning": "Any stored data or log retained after processing."
        }
      ]
    },
