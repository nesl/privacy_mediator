  "example_pipeline": {
    "pipeline_id": "hvac_occupancy_count_v1",
    "application_contract": {
      "requested_capability": "occupancy",
      "purpose": "energy_management",
      "accepted_output_caps": [
        "application/x-occupancy"
      ],
      "quality_constraints": {
        "max_latency_ms": 300000,
        "max_count_mae": 2
      },
      "affordance_type": "property"
    },
    "operators": [
      {
        "id": "cam0",
        "operator_class": "source",
        "output": "video/x-raw"
      },
      {
        "id": "sample0",
        "operator_class": "sample",
        "output": "image/x-frame"
      },
      {
        "id": "detect0",
        "operator_class": "person_object_detector",
        "output": "application/x-detections"
      },
      {
        "id": "count0",
        "operator_class": "occupancy_deriver",
        "output": "application/x-occupancy"
      },
      {
        "id": "agg0",
        "operator_class": "aggregate_generalize",
        "output": "application/x-occupancy"
      },
      {
        "id": "adapter0",
        "operator_class": "schema_adapter",
        "output": "wot/property"
      },
      {
        "id": "publish0",
        "operator_class": "route_publish",
        "output": "external_endpoint"
      }
    ],
    "final_output_metadata": {
      "cap": "application/x-occupancy",
      "informationType": "occupancy_count",
      "residual_attributes": [
        "aggregate_presence",
        "room_level_location"
      ],
      "transformations_applied": [
        "temporal_downsampling",
        "derive_occupancy",
        "aggregate_only",
        "data_minimized"
      ]
    }
  }
