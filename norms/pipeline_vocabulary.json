{
  "schema_version": "application_pipeline_vocab_v1",
  "created_for": "privacy_preprocessing_hub_application_pipelines",
  "design_notes": [
    "This vocabulary is separate from the CI policy vocabulary. It describes executable/typed preprocessing pipelines, operator interfaces, data schemas, and metadata needed for composition.",
    "The core abstraction is a dataflow graph with typed ports. Ports advertise caps: media caps for stream-like data, semantic caps for derived observations/events, and policy/control caps for non-payload decisions.",
    "The design borrows GStreamer-style caps/ports for internal compatibility, WoT-style properties/actions/events for application-facing affordances, SOSA/SSN-style sensor/observation terms for sensing records, DPV terms for privacy/processing measures, ODRL-like terms for permissions/prohibitions/duties, and Peekaboo-style fixed chainable operators/manifests.",
    "Each operator declares input caps, output caps, parameters, transformation effects, residual disclosure effects, and utility capabilities. Pipeline composition is valid only when each downstream input cap is compatible with an upstream output cap or an explicit adapter exists.",
    "Residual disclosure annotations are defaults/prior metadata; they should be calibrated by empirical leakage probes when data is available."
  ],
  "source_registry": {
    "gstreamer": {
      "description": "Used as inspiration for dataflow elements, pads/ports, media caps, and caps negotiation.",
      "examples": [
        "Element",
        "Pad",
        "Caps",
        "video/x-raw",
        "audio/x-raw",
        "application/x-*"
      ],
      "url": "https://gstreamer.freedesktop.org/documentation/"
    },
    "wot": {
      "description": "Used as inspiration for app-facing affordances: properties, actions, events, forms, and data schemas.",
      "examples": [
        "Thing",
        "PropertyAffordance",
        "ActionAffordance",
        "EventAffordance",
        "forms"
      ],
      "url": "https://www.w3.org/TR/wot-thing-description11/"
    },
    "sosa_ssn": {
      "description": "Used as inspiration for sensors, observations, observable properties, and procedures.",
      "examples": [
        "Sensor",
        "Observation",
        "ObservableProperty",
        "Procedure",
        "Result"
      ],
      "url": "https://www.w3.org/TR/vocab-ssn/"
    },
    "dpv": {
      "description": "Used as inspiration for privacy processing, personal data categories, technical/organizational measures, aggregation, redaction, de-identification, and processing context.",
      "examples": [
        "PersonalData",
        "Processing",
        "DataRedaction",
        "Deidentification",
        "Aggregation"
      ],
      "url": "https://w3id.org/dpv/"
    },
    "odrl": {
      "description": "Used as inspiration for policy effects over data assets: permissions, prohibitions, and duties/obligations.",
      "examples": [
        "Policy",
        "Permission",
        "Prohibition",
        "Duty",
        "Action"
      ],
      "url": "https://www.w3.org/TR/odrl-model/"
    },
    "peekaboo": {
      "description": "Used as inspiration for fixed, chainable hub operators and application manifests declaring data collection and preprocessing behavior.",
      "examples": [
        "chainable operators",
        "application manifest",
        "preprocessing hub"
      ],
      "url": "https://arxiv.org/abs/2204.04540"
    },
    "smartpriv": {
      "description": "Created extension terms for this smart-space privacy hub when no direct standard term exists."
    }
  },
  "core_model_terms": {
    "pipeline": {
      "source": "gstreamer + peekaboo + smartpriv",
      "meaning": "A directed dataflow graph of operators from sensor sources to application-facing outputs."
    },
    "operator": {
      "source": "gstreamer + peekaboo",
      "meaning": "A reusable processing element with typed input/output ports and metadata effects."
    },
    "port": {
      "source": "gstreamer",
      "meaning": "A named input or output boundary of an operator. Similar to a GStreamer pad."
    },
    "caps": {
      "source": "gstreamer",
      "meaning": "A machine-readable description of what kind of data can travel through a port."
    },
    "capsNegotiation": {
      "source": "gstreamer",
      "meaning": "Compatibility check that determines whether an upstream output cap can satisfy a downstream input cap."
    },
    "affordance": {
      "source": "wot",
      "meaning": "Application-facing capability exposed as a property, action, or event."
    },
    "observation": {
      "source": "sosa_ssn",
      "meaning": "A result of sensing or derivation about an observable property."
    },
    "policyEffect": {
      "source": "odrl + smartpriv",
      "meaning": "An allow, deny, duty, or review outcome that constrains whether a flow may be executed or exported."
    }
  },
  "capability_namespaces": {
    "media": {
      "source": "gstreamer",
      "description": "Stream-like raw or transformed media caps.",
      "terms": [
        {
          "cap": "video/x-raw",
          "source": "gstreamer",
          "meaning": "Uncompressed video frames."
        },
        {
          "cap": "audio/x-raw",
          "source": "gstreamer",
          "meaning": "Uncompressed audio samples."
        },
        {
          "cap": "image/x-frame",
          "source": "smartpriv + gstreamer-style",
          "meaning": "Single image frame as a bounded item."
        },
        {
          "cap": "video/x-redacted",
          "source": "smartpriv + gstreamer-style",
          "meaning": "Video-like output with redaction metadata such as face_blurred or screen_masked."
        },
        {
          "cap": "audio/x-filtered",
          "source": "smartpriv + gstreamer-style",
          "meaning": "Audio-like output after filtering/removal of selected content."
        }
      ]
    },
    "semantic": {
      "source": "wot + sosa_ssn + smartpriv",
      "description": "Derived observations, events, and semantic representations.",
      "terms": [
        {
          "cap": "application/x-detections",
          "source": "smartpriv",
          "meaning": "Detected objects/persons/faces/screens as classes, scores, and regions."
        },
        {
          "cap": "application/x-region-set",
          "source": "smartpriv",
          "meaning": "Regions of interest or regions to suppress."
        },
        {
          "cap": "application/x-pose-keypoints",
          "source": "smartpriv",
          "meaning": "Human skeletal keypoints and confidence scores."
        },
        {
          "cap": "application/x-visible-text-regions",
          "source": "smartpriv",
          "meaning": "OCR/screen/document regions and optional recognized text."
        },
        {
          "cap": "application/x-decibel-level",
          "source": "smartpriv + policy",
          "meaning": "Sound pressure or noise level over a window, without waveform content."
        },
        {
          "cap": "application/x-sound-event",
          "source": "smartpriv",
          "meaning": "Audio event label such as alarm, glass_break, baby_cry, knock, speech_present."
        },
        {
          "cap": "application/x-command-intent",
          "source": "wot + smartpriv",
          "meaning": "Narrow voice-command intent or keyword flag."
        },
        {
          "cap": "application/x-occupancy",
          "source": "wot + smartpriv",
          "meaning": "Binary occupancy or room-level count."
        },
        {
          "cap": "application/x-activity-event",
          "source": "smartpriv",
          "meaning": "Activity or safety/security event label such as fall_event or person_at_door."
        },
        {
          "cap": "application/x-aggregate",
          "source": "dpv + smartpriv",
          "meaning": "Spatial/temporal/category aggregate derived from lower-level observations."
        }
      ]
    },
    "control": {
      "source": "odrl + smartpriv",
      "description": "Non-payload caps used by policy gates and decision operators.",
      "terms": [
        {
          "cap": "application/x-policy-decision",
          "source": "odrl + smartpriv",
          "meaning": "allow, deny, require_condition, require_review, or no_compromise decision."
        },
        {
          "cap": "application/x-obligation-set",
          "source": "odrl + smartpriv",
          "meaning": "Required conditions such as disclosed, local_processing, limited_retention, or authorized_personnel_only."
        },
        {
          "cap": "application/x-audit-record",
          "source": "dpv + odrl + smartpriv",
          "meaning": "Decision trace for audit/explanation."
        }
      ]
    }
  },
  "cap_fields": {
    "common": {
      "source": "gstreamer + smartpriv",
      "fields": [
        {
          "name": "media_type",
          "meaning": "Primary cap string, e.g. video/x-raw or application/x-occupancy."
        },
        {
          "name": "schema",
          "meaning": "JSON schema or named schema for semantic outputs."
        },
        {
          "name": "unit",
          "meaning": "Measurement unit such as people, dB, confidence, seconds."
        },
        {
          "name": "timestamped",
          "meaning": "Whether items carry timestamps."
        },
        {
          "name": "spatial_scope",
          "meaning": "frame, region, room, zone, home, building, outdoor_area."
        },
        {
          "name": "temporal_scope",
          "meaning": "instant, window, event, aggregate."
        },
        {
          "name": "subject_granularity",
          "meaning": "individual, group, aggregate, none."
        },
        {
          "name": "retains_raw_payload",
          "meaning": "Whether raw pixel/audio/text payload remains."
        }
      ]
    },
    "video": {
      "source": "gstreamer",
      "fields": [
        {
          "name": "format",
          "examples": [
            "RGB",
            "BGR",
            "GRAY8"
          ]
        },
        {
          "name": "width"
        },
        {
          "name": "height"
        },
        {
          "name": "framerate"
        },
        {
          "name": "colorimetry"
        },
        {
          "name": "interlace_mode"
        }
      ]
    },
    "audio": {
      "source": "gstreamer",
      "fields": [
        {
          "name": "format",
          "examples": [
            "S16LE",
            "F32LE"
          ]
        },
        {
          "name": "rate"
        },
        {
          "name": "channels"
        },
        {
          "name": "layout"
        }
      ]
    },
    "privacy_annotations": {
      "source": "dpv + smartpriv",
      "fields": [
        {
          "name": "transformations_applied",
          "examples": [
            "face_blur",
            "screen_mask",
            "speech_content_removal",
            "aggregate"
          ]
        },
        {
          "name": "residual_attributes",
          "examples": [
            "identity",
            "face",
            "body_shape",
            "clothing",
            "gait",
            "speech_content",
            "speaker_identity",
            "activity",
            "location",
            "trajectory",
            "co_presence",
            "visible_text",
            "aggregate_presence"
          ]
        },
        {
          "name": "disclosure_delta",
          "examples": [
            "remove",
            "reduce",
            "preserve",
            "create",
            "abstract"
          ]
        },
        {
          "name": "probe_evidence",
          "meaning": "Leakage probes used to calibrate disclosure estimate."
        }
      ]
    }
  },
  "operator_interface_schema": {
    "required_fields": [
      "operator_id",
      "operator_class",
      "display_name",
      "source_basis",
      "input_ports",
      "output_ports",
      "parameters",
      "utility_capabilities",
      "transformation_effects",
      "residual_disclosure_effects"
    ],
    "field_definitions": {
      "operator_id": "Stable identifier.",
      "operator_class": "One of the operator_classes terms below.",
      "display_name": "Human readable name.",
      "source_basis": "Where the interface idea comes from.",
      "input_ports": "List of typed input ports with accepted caps.",
      "output_ports": "List of typed output ports with produced caps.",
      "parameters": "Operator-specific parameter names and types.",
      "utility_capabilities": "Application capabilities this operator may support.",
      "transformation_effects": "Semantic processing/transformation tags applied by this operator.",
      "residual_disclosure_effects": "Default residual disclosure deltas over privacy attributes.",
      "composition_notes": "How to combine this operator with others.",
      "probe_hooks": "Empirical leakage/utility probes relevant to validating the operator."
    }
  },
