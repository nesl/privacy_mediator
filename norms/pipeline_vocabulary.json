  "application_contract_terms": {
    "source": "wot + openapi-style + smartpriv",
    "description": "Terms used by downstream applications to declare utility and compatibility.",
    "fields": [
      {
        "name": "requested_capability",
        "examples": [
          "occupancy",
          "fall_detection",
          "voice_command",
          "security_event",
          "noise_monitoring"
        ]
      },
      {
        "name": "purpose",
        "examples": [
          "energy_management",
          "safety_monitoring",
          "security_monitoring",
          "communication"
        ]
      },
      {
        "name": "accepted_output_caps",
        "examples": [
          "application/x-occupancy",
          "application/x-activity-event",
          "video/x-redacted"
        ]
      },
      {
        "name": "quality_constraints",
        "examples": [
          "max_latency_ms",
          "min_f1",
          "max_count_mae",
          "min_recall"
        ]
      },
      {
        "name": "recipient",
        "examples": [
          "hvac_controller",
          "caregiver_app",
          "security_app"
        ]
      },
      {
        "name": "retention_request",
        "examples": [
          "none",
          "ephemeral",
          "event_clip_only"
        ]
      },
      {
        "name": "affordance_type",
        "source": "wot",
        "examples": [
          "property",
          "action",
          "event"
        ]
      }
    ]
  },
  "residual_disclosure_attributes": {
    "source": "smartpriv + dpv-pd",
    "scoring": {
      "scale": "0.0 to 1.0 or ordinal {none, low, medium, high}",
      "combination_default": "conservative_max(meta, probe) unless deployment validation justifies lowering",
      "not_a_total_order": true
    },
    "attributes": [
      {
        "term": "identity",
        "source": "dpv-pd + smartpriv"
      },
      {
        "term": "face",
        "source": "dpv-pd + smartpriv"
      },
      {
        "term": "body_shape",
        "source": "smartpriv"
      },
      {
        "term": "clothing",
        "source": "smartpriv"
      },
      {
        "term": "gait",
        "source": "smartpriv"
      },
      {
        "term": "speech_content",
        "source": "dpv-pd + smartpriv"
      },
      {
        "term": "speaker_identity",
        "source": "dpv-pd + smartpriv"
      },
      {
        "term": "activity",
        "source": "dpv-pd + smartpriv"
      },
      {
        "term": "location",
        "source": "dpv-pd + smartpriv"
      },
      {
        "term": "trajectory",
        "source": "dpv-pd + smartpriv"
      },
      {
        "term": "co_presence",
        "source": "smartpriv"
      },
      {
        "term": "visible_text",
        "source": "smartpriv"
      },
      {
        "term": "aggregate_presence",
        "source": "smartpriv"
      }
    ],
    "delta_terms": [
      {
        "term": "remove",
        "meaning": "Attribute should no longer be inferable from output under normal probes."
      },
      {
        "term": "reduce",
        "meaning": "Attribute remains inferable at lower confidence/granularity."
      },
      {
        "term": "preserve",
        "meaning": "Attribute remains substantially inferable."
      },
      {
        "term": "create",
        "meaning": "Operator creates or makes explicit a new derived attribute."
      },
      {
        "term": "abstract",
        "meaning": "Fine-grained attribute replaced by a coarser semantic representation."
      }
    ]
  },
  "composition_semantics": {
    "validity": [
      "A pipeline edge is valid if upstream.output_caps intersects downstream.input_caps.",
      "same_as_input means the operator preserves the upstream cap unless parameters specify otherwise.",
      "A schema_adapter may bridge caps only if its adapter rule explicitly maps source cap to target cap.",
      "policy_gate and obligation_annotator do not reduce residual disclosure unless paired with transformation operators."
    ],
    "residual_disclosure_composition": [
      "Start with source residual attributes implied by raw media or sensor primitive.",
      "For each operator in topological order, apply residual_disclosure_effects as a prior update.",
      "If empirical probe scores exist for a pipeline output, combine D_meta and D_probe using conservative_max by default.",
      "The final output cap plus residual disclosure vector becomes the candidate flow attribute for CI evaluation."
    ],
    "utility_composition": [
      "Each operator declares utility_capabilities it may support.",
      "A candidate pipeline satisfies an application only if final output cap is in accepted_output_caps and quality constraints are met by benchmark, validation, or deployment evidence.",
      "If the final cap is incompatible with the application and no adapter exists, the pipeline is infeasible even if it is privacy-preserving."
    ]
  },
